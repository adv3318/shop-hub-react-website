{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Vite: Debug in Chrome",
      "type": "pwa-chrome",
      "request": "launch",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}",
      "sourceMaps": true,
      "sourceMapPathOverrides": {
        "/@fs/*": "${workspaceFolder}/*",
        "vite:///*": "${workspaceFolder}/*"
      }
    }
  ]
}
