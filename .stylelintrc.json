{
  "extends": ["stylelint-config-standard-scss"],
  "plugins": ["stylelint-order"],
  "rules": {
    "selector-class-pattern": [
      "^[a-z][a-zA-Z0-9-]*$",
      {
        "message": "Expected camelCase or kebab-case"
      }
    ],
    "no-descending-specificity": null,
    "order/order": [
      [
        "custom-properties",
        "declarations",
        {
          "type": "at-rule",
          "name": "media"
        },
        {
          "type": "rule",
          "selector": "&:hover"
        },
        {
          "type": "rule",
          "selector": "&:active"
        }
      ],
      {
        "severity": "warning"
      }
    ],
    "order/properties-order": [
      [
        {
          "groupName": "Layout",
          "properties": [
            "position",
            "inset",
            "top",
            "right",
            "bottom",
            "left",
            "z-index",
            "display",
            "flex",
            "flex-direction",
            "flex-wrap",
            "flex-flow",
            "justify-content",
            "align-items",
            "align-content",
            "gap",
            "place-content",
            "place-items",
            "grid",
            "grid-template",
            "grid-template-columns",
            "grid-template-rows",
            "grid-auto-flow",
            "grid-auto-columns",
            "grid-auto-rows"
          ]
        },
        {
          "groupName": "Box Model",
          "properties": [
            "box-sizing",
            "width",
            "min-width",
            "max-width",
            "height",
            "min-height",
            "max-height",
            "margin",
            "margin-top",
            "margin-right",
            "margin-bottom",
            "margin-left",
            "padding",
            "padding-top",
            "padding-right",
            "padding-bottom",
            "padding-left",
            "border",
            "border-width",
            "border-style",
            "border-color",
            "border-radius",
            "outline",
            "box-shadow"
          ]
        },
        {
          "groupName": "Typography",
          "properties": [
            "font",
            "font-family",
            "font-size",
            "font-weight",
            "line-height",
            "letter-spacing",
            "text-align",
            "text-decoration",
            "text-transform",
            "white-space",
            "color"
          ]
        },
        {
          "groupName": "Visual",
          "properties": [
            "background",
            "background-color",
            "background-image",
            "background-size",
            "background-position",
            "background-repeat",
            "opacity",
            "filter"
          ]
        },
        {
          "groupName": "Animation",
          "properties": ["transition", "transform", "animation"]
        }
      ],
      {
        "unspecified": "bottomAlphabetical"
      }
    ]
  }
}
